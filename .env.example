REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
GITHUB_WEBHOOK_SECRET=changeme
GIT_WORKSPACE_ROOT=app/workspace
GROQ_API_KEY=changeme
GROQ_MODEL=openai/gpt-oss-120b
# Optional Groq key pools, each a comma-separated list. Every key must be
# from a *separate* Groq account: quota is per-org, so two keys on one
# account share a single limit and rotating between them buys nothing.
# Calls rotate across a pool, are paced under GROQ_TPM_LIMIT per key, and
# wait out 429 cooldowns instead of failing. Unset pools use GROQ_API_KEY.
# Disjoint security/performance pools run those two specialists in parallel.
# GROQ_API_KEYS is the Synthesizer's pool (evaluation/run_reviews.py also
# rotates GROQ_API_KEY through it).
# GROQ_API_KEYS=gsk_syn_1,gsk_syn_2,gsk_syn_3,gsk_syn_4,gsk_syn_5
# GROQ_API_KEY_SECURITY=gsk_sec_1,gsk_sec_2,gsk_sec_3
# GROQ_API_KEY_PERFORMANCE=gsk_perf_1,gsk_perf_2,gsk_perf_3
# GROQ_TPM_LIMIT=8000
# Longest one Groq call waits for a key in its pool to cool down.
# GROQ_MAX_RATE_LIMIT_WAIT_SECONDS=900
# Daily token total (all keys) above which new reviews are deferred.
# GROQ_DAILY_TOKEN_BUDGET=10000000
# GitHub App auth (replaces the old PAT). GITHUB_APP_PRIVATE_KEY_B64 is the
# App's downloaded .pem, base64-encoded as a single line, e.g.:
#   base64 -w0 your-app-private-key.pem
GITHUB_APP_ID=changeme
GITHUB_APP_PRIVATE_KEY_B64=changeme

# Used only by evaluation/judge_results.py (the optional LLM-as-judge eval
# pass) -- not read by the app itself, so it's fine to leave unset unless
# you're running that script. May be a single key or a comma-separated list
# (e.g. GEMINI_API_KEY=key_one,key_two) -- a list rotates automatically on a
# 429/401/403 instead of stopping the run.
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.5-flash

# LangSmith tracing. On by default (LANGSMITH_TRACING defaults to true in
# code) but only actually activates once LANGSMITH_API_KEY is a real key
# (from smith.langchain.com) -- leave it as "changeme" to run untraced.
# Shows every specialist's ReAct tool-call loop and the Synthesizer call as
# a full trace per PR review.
LANGSMITH_API_KEY=changeme
LANGSMITH_PROJECT=pr-review-agent
# LANGSMITH_TRACING=false  # uncomment to force tracing off even with a key set
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # only needed for EU/self-hosted
